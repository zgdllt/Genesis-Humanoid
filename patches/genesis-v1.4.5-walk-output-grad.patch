+def _plane_cylinder_geometry_torch(pa, qa, pb, qb, qi, plane_dir, radius, half, ids, angle, noise, eps):
+    """Vectorized equivalent of the selected analytic QD plane-cylinder path."""
+    def dot(a, b):
+        return (a*b).sum(-1, keepdim=True)
+
+    def normalize(a):
+        return a / a.norm(dim=-1, keepdim=True)
+
+    def rotate(v, q):
+        w, xyz = q[:, :1], q[:, 1:]
+        return (v*(w*w-dot(xyz, xyz)) + 2*xyz*dot(xyz, v)
+                + 2*w*torch.linalg.cross(xyz, v)) / dot(q, q)
+
+    def inverse(q):
+        return torch.cat((q[:, :1], -q[:, 1:]), -1)
+
+    def compose(v, u):
+        uw, uv, vw, vv = u[:, :1], u[:, 1:], v[:, :1], v[:, 1:]
+        return normalize(torch.cat((uw*vw-dot(uv, vv), uw*vv+vw*uv+torch.linalg.cross(uv, vv)), -1))
+
+    z_axis = torch.zeros_like(pb)
+    z_axis[:, 2] = 1
+    radius, half = radius[:, None], half[:, None]
+
+    def support(n, p, q):
+        axis = rotate(z_axis, q)
+        projection = dot(n, axis)
+        endpoint = p + half*torch.where(projection < 0, -1., 1.)*axis
+        radial = n - projection*axis
+        squared = dot(radial, radial)
+        radial_offset = radius*radial/squared.clamp_min(1e-18).sqrt()
+        return endpoint + torch.where(squared > 1e-18, radial_offset, 0.)
+
+    def refine(p, n, depth):
+        qv = qb[:, 1:]
+        uv = torch.linalg.cross(qv, z_axis)
+        axis = z_axis + 2*(qb[:, :1]*uv + torch.linalg.cross(qv, uv))
+        axial = dot(p-pb, axis)
+        clamped = torch.minimum(torch.maximum(axial, -half), half)
+        snapped = pb + clamped*axis + (radius-.5*depth)*n
+        return torch.where(dot(n, axis).abs() < .5, snapped, p)
+
+    n = -normalize(rotate(plane_dir, qa))
+    witness0 = support(n, pb, qb)
+    raw0 = dot(n, witness0-pa)
+    p0 = witness0 - .5*raw0*n
+    d0 = raw0.clamp_min(0)
+    p0 = refine(p0, n, d0)
+    # Build the original inertial-frame perturbation basis.
+    local = rotate(n, inverse(qi))
+    x, y, z = local.unbind(-1)
+    raw_y = torch.stack((-x*y, 1-y*y, -z*y), -1)
+    raw_z = torch.stack((-x*z, -y*z, 1-z*z), -1)
+    b = normalize(torch.where((y.abs() < .5)[:, None], raw_y, raw_z))
