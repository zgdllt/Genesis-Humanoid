+@qd.kernel(fastcache=True)
+def kernel_pack_plane_cylinder_keys(
+    keys: qd.types.ndarray(), collider_state: array_class.ColliderState, dyn_info: array_class.DynInfo,
+):
+    for k in range(keys.shape[0]):
+        i_b = k % collider_state.n_contacts.shape[0]
+        i_c = k // collider_state.n_contacts.shape[0]
+        keys[k, 0] = -1
+        if i_c < collider_state.n_contacts[i_b]:
+            ga, gb = collider_state.contact_data.geom_a[i_c, i_b], collider_state.contact_data.geom_b[i_c, i_b]
+            if dyn_info.geoms.type[ga] == gs.GEOM_TYPE.PLANE and dyn_info.geoms.type[gb] == gs.GEOM_TYPE.CYLINDER:
+                gpos = collider_state.contact_data.pos.grad[i_c, i_b]
+                gnormal = collider_state.contact_data.normal.grad[i_c, i_b]
+                gdepth = collider_state.contact_data.penetration.grad[i_c, i_b]
+                if (gpos != 0.0).any() or (gnormal != 0.0).any() or gdepth != 0.0:
+                    keys[k, 0], keys[k, 1] = ga, gb
+                    keys[k, 2], keys[k, 3], keys[k, 4] = dyn_info.geoms.link_idx[gb], i_b, i_c
+                    keys[k, 5] = collider_state.diff_contact_input.plane_detection_id[i_b, i_c]
+
+
+@qd.kernel(fastcache=True)
+def kernel_pack_plane_cylinder_values(
+    keys: qd.types.ndarray(), values: qd.types.ndarray(),
+    geoms_init_AABB: array_class.GeomsInitAABB,
+    dyn_state: array_class.DynState, collider_state: array_class.ColliderState, dyn_info: array_class.DynInfo,
+):
+    for k in range(keys.shape[0]):
+        ga, gb, link, i_b, i_c = keys[k, 0], keys[k, 1], keys[k, 2], keys[k, 3], keys[k, 4]
+        for axis in qd.static(range(3)):
+            values[k, axis] = dyn_state.geoms.pos[ga, i_b][axis]
+            values[k, 7+axis] = dyn_state.geoms.pos[gb, i_b][axis]
+            values[k, 18+axis] = dyn_info.geoms.data[ga][axis]
+            values[k, 24+axis] = collider_state.contact_data.pos.grad[i_c, i_b][axis]
+            values[k, 27+axis] = collider_state.contact_data.normal.grad[i_c, i_b][axis]
+        for axis in qd.static(range(4)):
+            values[k, 3+axis] = dyn_state.geoms.quat[ga, i_b][axis]
+            values[k, 10+axis] = dyn_state.geoms.quat[gb, i_b][axis]
+            values[k, 14+axis] = dyn_state.links.i_quat[link, i_b][axis]
+        values[k, 21] = dyn_info.geoms.data[gb][0]
+        values[k, 22] = 0.5*dyn_info.geoms.data[gb][1]
+        values[k, 23] = 0.5*(geoms_init_AABB[gb, 7] - geoms_init_AABB[gb, 0]).norm()
+        values[k, 30] = collider_state.contact_data.penetration.grad[i_c, i_b]
+
+
+@qd.kernel(fastcache=True)
+def kernel_scatter_plane_cylinder_grads(
+    keys: qd.types.ndarray(),
+    gpa: qd.types.ndarray(), gqa: qd.types.ndarray(), gpb: qd.types.ndarray(),
+    gqb: qd.types.ndarray(), gqi: qd.types.ndarray(),
+    dyn_state: array_class.DynState, collider_state: array_class.ColliderState,
+):
+    for k in range(keys.shape[0]):
+        ga, gb, link, i_b, i_c = keys[k, 0], keys[k, 1], keys[k, 2], keys[k, 3], keys[k, 4]
+        for axis in qd.static(range(3)):
+            qd.atomic_add(dyn_state.geoms.pos.grad[ga, i_b][axis], gpa[k, axis])
+            qd.atomic_add(dyn_state.geoms.pos.grad[gb, i_b][axis], gpb[k, axis])
+        for axis in qd.static(range(4)):
+            qd.atomic_add(dyn_state.geoms.quat.grad[ga, i_b][axis], gqa[k, axis])
+            qd.atomic_add(dyn_state.geoms.quat.grad[gb, i_b][axis], gqb[k, axis])
+            qd.atomic_add(dyn_state.links.i_quat.grad[link, i_b][axis], gqi[k, axis])
+        collider_state.contact_data.pos.grad[i_c, i_b] = gs.qd_vec3(0., 0., 0.)
+        collider_state.contact_data.normal.grad[i_c, i_b] = gs.qd_vec3(0., 0., 0.)
+        collider_state.contact_data.penetration.grad[i_c, i_b] = gs.qd_float(0.)
 
 
