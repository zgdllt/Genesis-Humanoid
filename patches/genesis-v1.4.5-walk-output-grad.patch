+    axis1 = (0.5**.5)*rotate(b-a, qi)
+    axis = torch.where((ids <= 2)[:, None], axis0, axis1)
+    axis = axis*torch.where(((ids == 2) | (ids == 4))[:, None], -1., 1.)
+    rv = angle*axis
+    squared = dot(rv, rv)
+    theta = squared.clamp_min(eps*eps).sqrt()
+    qr = torch.cat(((.5*theta).cos(), (.5*theta).sin()/theta*rv), -1)
+    qr = qr*(.5*(3-dot(qr, qr)))
+    identity = torch.zeros_like(qr)
+    identity[:, 0] = 1
+    qr = torch.where(squared > eps*eps, qr, identity)
+    inv_qr = inverse(qr)
+    pap = pa - (rotate(p0-pa, qr)-(p0-pa))
+    pbp = pb - (rotate(p0-pb, inv_qr)-(p0-pb))
+    qap, qbp = compose(qa, qr), compose(qb, inv_qr)
+    np = -normalize(rotate(plane_dir, qap))
+    sp = support(np, pbp, qbp)
+    rawp = dot(np, sp-pap)
+    pp = sp - .5*rawp*np
+    dp = rawp.clamp_min(0)
+    witness = rotate(pp+.5*dp*np-p0, qr) + p0
+    depth = dot(n, witness-p0)+.5*d0
+    position = witness-.5*depth*n
+    interpolate = (depth < 0) & (d0-depth > noise[:, None])
+    denominator = torch.where(interpolate, depth-d0, 1.)
+    position = position + torch.where(interpolate, depth/denominator*(p0-position), 0.)
+    depth = depth.clamp_min(0)
+    position = refine(position, n, depth)
+    position = torch.where((ids == 0)[:, None], p0, position)
+    depth = torch.where((ids == 0)[:, None], d0, depth)
+    return position, n, depth.squeeze(-1)
+
